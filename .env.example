# Postgres connection string for the database the storefront and the admin
# panel share.
DATABASE_URL=

# Signs the admin session cookie.
ADMIN_SESSION_SECRET=

# Cloudinary credentials for image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Canonical origin used when building links back to the storefront. Defaults to
# https://ronascorduene.com.
NEXT_PUBLIC_SITE_URL=https://ronascorduene.com

# Where to ping after a save so the storefront drops its cached pages. Local dev
# points at the dev server; production must use the deployed storefront origin.
# Both are optional: unset, the storefront is simply never pinged.
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate

# Must match REVALIDATE_SECRET in the storefront app.
STOREFRONT_REVALIDATE_SECRET=
