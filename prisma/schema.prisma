generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Product {
  id                 String   @id
  family             String
  category           String
  image              String
  /// Legacy attributes, superseded by `ProductTranslation.technicalDetails`.
  /// Kept nullable (and unused) so existing values are not destroyed; new
  /// products leave them empty.
  material           String?
  construction       String?
  finish             String?
  /// Regular price in USD. Null means "price on request".
  priceUsd           Decimal? @db.Decimal(10, 2)
  /// Sale price in USD. Only a value strictly below `priceUsd` counts.
  discountedPriceUsd Decimal? @db.Decimal(10, 2)
  /// USD discount percentage; derived from the two prices when omitted.
  discountPercentUsd Int?
  /// Regular price in Turkish Lira. Null means "price on request".
  priceTry           Decimal? @db.Decimal(10, 2)
  /// Sale price in TRY. Only a value strictly below `priceTry` counts.
  discountedPriceTry Decimal? @db.Decimal(10, 2)
  /// TRY discount percentage; derived from the two prices when omitted.
  discountPercentTry Int?
  visible            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  translations ProductTranslation[]
  orderItems   OrderItem[]

  @@index([visible])
  @@index([family])
  @@index([category])
  @@map("products")
}

/// Per-language product text. Product content lives in the database, not in
/// the UI dictionaries, so a product can exist in any subset of locales.
model ProductTranslation {
  id          String @id @default(uuid())
  productId   String
  locale      String
  name        String
  description String

  /// Ordered `{ label, value }` rows shown on the product detail page.
  /// Labels are translated per language, so the rows live on the translation.
  technicalDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([productId])
  @@map("product_translations")
}

/// A CMS-managed page (home, about, contact, impact, legal/*). Editorial text
/// is stored per language; sections carry the ordered, reorderable blocks.
model Page {
  id        String   @id @default(uuid())
  /// Stable identifier, e.g. "about" or "legal/privacy". Also the lookup key.
  key       String   @unique
  /// Human label shown in the admin panel.
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageTranslation[]
  sections     PageSection[]

  @@map("pages")
}

/// Per-language page-level text (SEO title/description, page subtitle).
model PageTranslation {
  id             String   @id @default(uuid())
  pageId         String
  locale         String
  title          String   @default("")
  subtitle       String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([pageId])
  @@map("page_translations")
}

/// A reorderable content block. `type` selects the frontend renderer and the
/// admin field set; `image`/`href` are shared across languages, everything
/// textual lives in the translations.
model PageSection {
  id        String   @id @default(uuid())
  pageId    String
  /// Stable within a page, used as the React key and for upserts.
  key       String
  /// Renderer identifier, e.g. "about-hero", "rich-text".
  type      String
  position  Int      @default(0)
  image     String   @default("")
  href      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page         Page                     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  translations PageSectionTranslation[]

  @@unique([pageId, key])
  @@index([pageId, position])
  @@map("page_sections")
}

/// Per-language section text. `items` holds structured lists (values, steps,
/// cards, contact rows) as JSON so new block shapes need no schema change.
model PageSectionTranslation {
  id        String   @id @default(uuid())
  sectionId String
  locale    String
  eyebrow   String   @default("")
  title     String   @default("")
  body      String   @default("")
  ctaLabel  String   @default("")
  items     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@index([sectionId])
  @@map("page_section_translations")
}

model Order {
  id                     String      @id @default(uuid())
  token                  String      @unique
  /// Human-friendly public order number ("RC-XXXXXXXX") used for tracking and
  /// in the order emails.
  trackingCode           String      @unique
  email                  String?
  phone                  String?
  firstName              String?
  lastName               String?
  notes                  String?
  status                 OrderStatus @default(DRAFT)
  submittedAt            DateTime?
  /// When the order was marked as shipped in the admin panel.
  shippedAt              DateTime?
  /// When the shipped-notification email was sent, so a retried notify call
  /// never produces a second "on its way" email for the same order.
  shippedEmailSentAt     DateTime?
  /// Currency the customer checked out in. Order totals are shown in it.
  currency               String      @default("TRY")
  /// Locale the customer checked out in (en | tr | ku | ar).
  locale                 String?
  /// Whether the customer accepted the Distance Sales Agreement.
  distanceSalesAccepted  Boolean     @default(false)
  /// Whether the customer acknowledged the Pre-Information Form.
  preInformationAccepted Boolean     @default(false)
  /// When the mandatory order agreement was accepted.
  agreementAcceptedAt    DateTime?
  /// Version of the legal documents in force when the agreement was accepted.
  legalVersion           String?
  /// Optional marketing consent, stored separately from the order agreement.
  marketingConsent       Boolean     @default(false)
  /// When marketing consent was given; null when it was declined.
  marketingConsentAt     DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String?
  quantity        Int      @default(1)
  /// Price snapshot captured when the order was submitted. Stored so later
  /// product price changes never alter an existing order's totals.
  unitPriceUsd    Decimal? @db.Decimal(10, 2)
  unitPriceTry    Decimal? @db.Decimal(10, 2)
  regularPriceUsd Decimal? @db.Decimal(10, 2)
  regularPriceTry Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}
